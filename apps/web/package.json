{
  "name": "@wager/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run --filter @wager/db prisma:generate && next build",
    "start": "next start",
    "lint": "eslint --config eslint.config.mjs --max-warnings 0 .",
    "test": "vitest run",
    "vercel-build": "bun run --filter @wager/db prisma:generate && bun run --filter @wager/db prisma:migrate:deploy && next build",
    "clean": "rm -rf node_modules .next",
    "prisma-sanity": "bash scripts/prisma-sanity.sh",
    "review-packet": "bash scripts/review-packet.sh"
  },
  "dependencies": {
    "@wager/auth": "workspace:*",
    "@wager/db": "workspace:*",
    "@wager/domain": "workspace:*",
    "@wager/payments": "workspace:*",
    "@wager/shared": "workspace:*",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.90.2",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "^0.540.0",
    "motion": "^12.23.12",
    "next": "^16",
    "nextjs-toploader": "^3.8.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.2",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.1.12",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "22.x"
  }
}
